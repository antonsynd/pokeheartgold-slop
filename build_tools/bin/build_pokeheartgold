#!/usr/bin/env python3
"""Chiri build-system entry point for pokeheartgold.

Wraps pret's Meson build behind a chiri-style subcommand CLI so that
`chiri pkg build`, `chiri pkg test`, etc. map onto the right `meson` / `ninja`
invocations for each game. The first build of a game configures it through the
top-level Makefile (`make GAME_VERSION=... setup_rom`), which also fetches
meson and metroskrew.
"""
import argparse
import json
import logging
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Mapping, MutableMapping, MutableSequence, Sequence

_logger: logging.Logger = logging.getLogger(name="build_pokeheartgold")

ROOT_DIR: Path = Path(__file__).resolve().parent.parent.parent
MESON: Path = ROOT_DIR / "subprojects" / "meson-1.12.0" / "meson.py"

HEARTGOLD: str = "heartgold"
SOULSILVER: str = "soulsilver"
BOTH: str = "both"
GAME_CHOICES: Sequence[str] = (HEARTGOLD, SOULSILVER, BOTH)

GAME_VERSION: Mapping[str, str] = {
    HEARTGOLD: "HEARTGOLD",
    SOULSILVER: "SOULSILVER",
}

TARGETS: Sequence[str] = ("all", "main", "sub", "filesystem")


def main() -> None:
    setup_logger()

    parser: argparse.ArgumentParser = create_parser()
    pre_args: MutableSequence[str] = []
    rest: MutableSequence[str] = []

    for i, arg in enumerate(sys.argv[1:], start=1):
        if arg == "--":
            rest.extend(sys.argv[i + 1 :])
            break

        pre_args.append(arg)

    args: argparse.Namespace = parser.parse_args(pre_args)
    command: str = args.command

    if command == "build":
        build(args=args, rest=rest, compare=not args.no_compare)
    elif command == "compare" or command == "test":
        build(args=args, rest=rest, compare=True)
    elif command == "clean":
        clean(args=args)
    elif command == "tidy":
        tidy(args=args)
    elif command == "format":
        format_tree(args=args, rest=rest)
    elif command == "help" or command is None:
        parser.print_help()
    else:
        get_logger().error(f'Unknown command "{command}"')
        sys.exit(1)


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="build_pokeheartgold",
        description="Meta-build wrapper around pret's Meson build.",
    )
    subparsers = parser.add_subparsers(dest="command")

    build_parser = subparsers.add_parser(
        "build",
        help="Build the ROM (or a partial target), then run the sha1 tests.",
    )
    _add_game_arg(build_parser)
    build_parser.add_argument(
        "--target",
        choices=TARGETS,
        default="all",
        help="What to build: all = the ROM, main = the ARM9 binary (main.nef), "
        "sub = the ARM7 binary, filesystem = the NitroFS files (default: all).",
    )
    build_parser.add_argument(
        "--no-compare",
        action="store_true",
        help="Skip the sha1 tests against the retail hashes.",
    )
    _add_jobs_arg(build_parser)

    compare_parser = subparsers.add_parser(
        "compare",
        help="Build the ROM and run the sha1 tests (main, sub, filesystem, ROM).",
    )
    _add_game_arg(compare_parser)
    _add_jobs_arg(compare_parser)

    test_parser = subparsers.add_parser(
        "test",
        help="Alias for `compare`: the decomp's matching check is its test.",
    )
    _add_game_arg(test_parser)
    _add_jobs_arg(test_parser)
    # `test` and `compare` share build()'s code path; give them the same shape
    # as `build` so arg lookups are uniform.
    test_parser.set_defaults(target="all", no_compare=False)
    compare_parser.set_defaults(target="all", no_compare=False)

    clean_parser = subparsers.add_parser(
        "clean",
        help="Delete the game's build directory (the next build reconfigures).",
    )
    _add_game_arg(clean_parser)

    tidy_parser = subparsers.add_parser(
        "tidy",
        help="Delete build outputs but keep the configuration (ninja -t clean).",
    )
    _add_game_arg(tidy_parser)

    _ = subparsers.add_parser(
        "format",
        help="Run ./format.sh over src/ and include/.",
    )

    _ = subparsers.add_parser("help", help="Print this help message.")

    return parser


def _add_game_arg(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--game",
        choices=GAME_CHOICES,
        default=HEARTGOLD,
        help="Which ROM to operate on (default: heartgold).",
    )


def _add_jobs_arg(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "-j",
        "--jobs",
        type=int,
        default=None,
        help="Parallel jobs for ninja (e.g. -j8). Default: ninja's own choice.",
    )


def _games_for(args: argparse.Namespace) -> Sequence[str]:
    if args.game == BOTH:
        return (HEARTGOLD, SOULSILVER)
    return (args.game,)


def build_dir(game: str) -> Path:
    return ROOT_DIR / "build" / f"{game}.us"


def _env() -> MutableMapping[str, str]:
    env: MutableMapping[str, str] = os.environ.copy()
    # meson reads $NINJA as the name of one program; a value with arguments
    # ("ninja -j8") makes configure fail with "Could not detect Ninja".
    env.pop("NINJA", None)
    # makelcf (built from the NitroSDK subproject) needs a modern bison and
    # flex; Homebrew installs them keg-only, behind macOS's 2006-era bison.
    extra = [
        p
        for p in ("/opt/homebrew/opt/bison/bin", "/opt/homebrew/opt/flex/bin")
        if os.path.isdir(p)
    ]
    if extra:
        env["PATH"] = os.pathsep.join(extra + [env.get("PATH", "")])
    return env


def _run(cmd: Sequence[str], what: str) -> None:
    get_logger().info(f"$ {' '.join(cmd)}")
    try:
        subprocess.run(cmd, check=True, cwd=ROOT_DIR, env=_env())
    except subprocess.CalledProcessError as e:
        get_logger().error(f"{what} failed: {e}")
        sys.exit(e.returncode or 1)


def ensure_configured(game: str) -> None:
    if (build_dir(game) / "build.ninja").is_file() and MESON.is_file():
        return
    _run(["make", f"GAME_VERSION={GAME_VERSION[game]}", "setup_rom"], "configure")


def ensure_subprojects_current() -> None:
    """Check out each wrap-git subproject at its .wrap's revision.

    Meson fetches a subproject once and never moves it, so after a pull that
    bumps a .wrap (e.g. NitroDWC for pret #523) the old checkout keeps building
    against the old headers and fails in confusing ways."""
    for wrap in sorted((ROOT_DIR / "subprojects").glob("*.wrap")):
        fields: MutableMapping[str, str] = {}
        for line in wrap.read_text().splitlines():
            key, sep, value = line.partition("=")
            if sep:
                fields[key.strip()] = value.strip()
        rev, directory = fields.get("revision"), fields.get("directory")
        if not rev or not directory:
            continue
        checkout = ROOT_DIR / "subprojects" / directory
        if not (checkout / ".git").exists():
            continue  # not fetched yet; configure fetches it at the right revision
        head = subprocess.run(
            ["git", "-C", str(checkout), "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
        ).stdout.strip()
        if head and head != rev:
            get_logger().info(f"{directory} is at {head[:9]}, {wrap.name} wants {rev[:9]}")
            _run(
                [sys.executable, str(MESON), "subprojects", "update", "--sourcedir", str(ROOT_DIR), wrap.stem],
                "subproject update",
            )


def _filesystem_targets(game: str) -> Sequence[str]:
    """Ninja paths of every custom target defined under files/ (the NitroFS)."""
    out = subprocess.run(
        [sys.executable, str(MESON), "introspect", str(build_dir(game)), "--targets"],
        capture_output=True,
        text=True,
        check=True,
        cwd=ROOT_DIR,
    ).stdout
    paths: MutableSequence[str] = []
    for t in json.loads(out):
        if f"{os.sep}files{os.sep}" in t["defined_in"]:
            paths.extend(os.path.relpath(f, build_dir(game)) for f in t["filename"])
    return paths


def build(args: argparse.Namespace, rest: Sequence[str], compare: bool) -> None:
    if MESON.is_file():
        ensure_subprojects_current()
    for game in _games_for(args):
        ensure_configured(game)
        bdir = str(build_dir(game))
        jobs = [f"-j{args.jobs}"] if args.jobs else []

        if args.target == "filesystem":
            _run(["ninja", "-C", bdir, *jobs, *_filesystem_targets(game), *rest], "build")
        else:
            name = {
                "all": f"poke{game}.us.nds",
                "main": "main",
                "sub": "ichneumon_sub",
            }[args.target]
            _run(
                [sys.executable, str(MESON), "compile", "-C", bdir, *jobs, name, *rest],
                "build",
            )

        if compare:
            # The tests depend on the ROM (a fork edit to meson.build, see
            # tools/decomp_harness/MESON_SYNC_PLAN.md D7), so this rebuilds it
            # first and can't pass on stale files.
            _run(
                [sys.executable, str(MESON), "test", "-C", bdir, "--print-errorlogs"],
                "compare",
            )


def clean(args: argparse.Namespace) -> None:
    for game in _games_for(args):
        bdir = build_dir(game)
        if bdir.is_dir():
            get_logger().info(f"Removing {bdir}")
            shutil.rmtree(bdir)


def tidy(args: argparse.Namespace) -> None:
    for game in _games_for(args):
        bdir = build_dir(game)
        if (bdir / "build.ninja").is_file():
            _run(["ninja", "-C", str(bdir), "-t", "clean"], "tidy")


def format_tree(args: argparse.Namespace, rest: Sequence[str]) -> None:
    script: Path = ROOT_DIR / "format.sh"

    if not script.is_file():
        get_logger().error(f"format.sh not found at {script}")
        sys.exit(1)

    get_logger().info("Running ./format.sh...")
    try:
        subprocess.run([str(script), *rest], check=True, cwd=ROOT_DIR)
    except subprocess.CalledProcessError as e:
        get_logger().error(f"format.sh failed: {e}")
        sys.exit(e.returncode or 1)


def get_logger() -> logging.Logger:
    return _logger


def setup_logger() -> None:
    _logger.setLevel(logging.DEBUG)

    stdout_handler = logging.StreamHandler(sys.stdout)
    stdout_handler.setLevel(logging.DEBUG)
    stdout_handler.addFilter(lambda r: r.levelno <= logging.INFO)

    stderr_handler = logging.StreamHandler(sys.stderr)
    stderr_handler.setLevel(logging.WARNING)
    stderr_handler.addFilter(lambda r: r.levelno >= logging.WARNING)

    formatter = logging.Formatter("%(name)s: %(levelname)s: %(message)s")
    stdout_handler.setFormatter(formatter)
    stderr_handler.setFormatter(formatter)

    _logger.addHandler(stdout_handler)
    _logger.addHandler(stderr_handler)


if __name__ == "__main__":
    main()
