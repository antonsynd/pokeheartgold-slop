#!/bin/sh
# Redirect output to stderr.
exec 1>&2

# Run clang-format on staged files; abort the commit if any files are changed
if ! git clang-format --extensions c,cpp,h,hpp ; then
    echo "linting made changes to source files; aborting commit"
    exit 1
fi

# Check for duplicate function declarations in staged headers.
# MWCC -W error rejects redeclarations (even K&R vs prototyped).
if git diff --cached --name-only --diff-filter=ACM -- 'include/*.h' | grep -q .; then
    if ! tools/decomp_harness/check_dup_decls.sh; then
        exit 1
    fi
fi

# Check for IPA cascade from header changes (requires a built tree).
# Skipped if no build exists — run `chiri pkg -- build` first.
if git diff --cached --name-only --diff-filter=M -- 'include/*.h' | grep -q .; then
    if [ -d build/heartgold.us ]; then
        if ! tools/decomp_harness/ipa_check.sh; then
            exit 1
        fi
    fi
fi

# Verify build attestation is current when source files change.
if git diff --cached --name-only | grep -qE '^(main\.lsf|src/|asm/|include/)'; then
    if ! tools/build_attestation.sh --check 2>/dev/null; then
        echo ""
        echo "Build attestation is stale or missing."
        echo "Run: ./tools/build_attestation.sh"
        echo "Then stage build_attestation.json and retry."
        exit 1
    fi
    git add build_attestation.json 2>/dev/null || true
fi

# Auto-update progress stats in README.md when decomp-related files change.
# Regenerates coverage_ledger.json, patches the progress table, and stages README.md.
if git diff --cached --name-only | grep -qE '^(main\.lsf|src/|asm/|tools/decomp_harness/progress\.json|tools/decomp_harness/blockers\.json)'; then
    if python3 tools/decomp_harness/coverage_ledger.py --quiet 2>/dev/null; then
        if tools/decomp_harness/update_readme_progress.sh 2>/dev/null; then
            git add README.md tools/decomp_harness/coverage_ledger.json tools/decomp_harness/COVERAGE.md 2>/dev/null || true
        fi
    fi
fi
