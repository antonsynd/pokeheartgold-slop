#!/bin/sh
# Redirect output to stderr.
exec 1>&2

# Run clang-format on staged files; abort the commit if any files are changed
if ! git clang-format --extensions c,cpp,h,hpp ; then
    echo "linting made changes to source files; aborting commit"
    exit 1
fi

# Check for duplicate function declarations in staged headers. The build no
# longer passes -W error (D4), so a redeclaration now compiles silently;
# this check is what still catches it.
if git diff --cached --name-only --diff-filter=ACM -- 'include/*.h' | grep -q .; then
    if ! tools/decomp_harness/check_dup_decls.sh; then
        exit 1
    fi
fi

# The Meson source lists are generated from main.lsf; they must not drift.
if git diff --cached --name-only | grep -qE '^(main\.lsf|src/meson\.build|asm/meson\.build)$'; then
    if ! python3 tools/decomp_harness/meson_port.py lists --check; then
        exit 1
    fi
fi

# Check for IPA cascade from header changes. Both checks compile through
# compile_cmd.py, which needs a configured HeartGold build dir
# (build/heartgold.us/build.ninja and compile_commands.json).
if git diff --cached --name-only --diff-filter=M -- 'include/*.h' | grep -q .; then
    if [ ! -f build/heartgold.us/build.ninja ]; then
        echo "pre-commit: build/heartgold.us is not configured; skipping the IPA and"
        echo "drift checks for the staged header edits. Build once to enable them."
    else
        if ! tools/decomp_harness/ipa_check.sh; then
            exit 1
        fi
        # T1.6 drift smoke: header edits are the main regression vector for
        # already-matched TUs — recompile a random sample of 20 and diff their
        # allocatable-section fingerprints against the manifest (~30 s).
        # Requires a manifest and MWCC not already busy (prebuild_guard rules).
        if [ -f tools/decomp_harness/matched_manifest.json ]; then
            if ! tools/decomp_harness/verify_matched.sh check --quick 20; then
                echo ""
                echo "verify_matched --quick 20 found drift in already-matched TUs."
                echo "Run: tools/decomp_harness/verify_matched.sh check   (full sweep)"
                echo "to see the extent, and fix or split-header the change."
                exit 1
            fi
        fi
    fi
fi

# Regenerate the coverage ledger when decomp-related files change, so COVERAGE.md
# (function-level coverage) stays current. README's PROGRESS block is not
# patched here: the update-progress workflow regenerates it on mainline.
if git diff --cached --name-only | grep -qE '^(main\.lsf|src/|asm/|tools/decomp_harness/progress\.json|tools/decomp_harness/blockers\.json)'; then
    if python3 tools/decomp_harness/coverage_ledger.py --quiet 2>/dev/null; then
        git add tools/decomp_harness/coverage_ledger.json tools/decomp_harness/COVERAGE.md 2>/dev/null || true
    fi
fi
