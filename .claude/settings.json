{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clang_format_edit.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clean_bad_deps.sh",
            "if": "Bash(chiri:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clean_bad_deps.sh",
            "if": "Bash(make:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clean_bad_deps.sh",
            "if": "Bash(gmake:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clean_bad_deps.sh",
            "if": "Bash(build_tools/bin/build_pokeheartgold:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clean_bad_deps.sh",
            "if": "Bash(./build_tools/bin/build_pokeheartgold:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clean_bad_deps.sh",
            "if": "Bash(tools/build_attestation.sh:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/clean_bad_deps.sh",
            "if": "Bash(./tools/build_attestation.sh:*)",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/hooks/block_generated.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph detect-changes --brief",
            "if": "Bash(git commit:*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/prebuild_guard.sh",
            "if": "Bash(chiri:*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/prebuild_guard.sh",
            "if": "Bash(make:*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/prebuild_guard.sh",
            "if": "Bash(gmake:*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/prebuild_guard.sh",
            "if": "Bash(build_tools/bin/build_pokeheartgold:*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/prebuild_guard.sh",
            "if": "Bash(./build_tools/bin/build_pokeheartgold:*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/prebuild_guard.sh",
            "if": "Bash(tools/build_attestation.sh:*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/decomp_harness/prebuild_guard.sh",
            "if": "Bash(./tools/build_attestation.sh:*)",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
